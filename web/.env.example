# mezoTestnet or mezo.
NEXT_PUBLIC_CHAIN=mezoTestnet
# Optional; defaults to the chain's public RPC.
NEXT_PUBLIC_RPC_URL=

# From `forge script script/Deploy.s.sol`.
NEXT_PUBLIC_POSITIONS_ADDRESS=
NEXT_PUBLIC_MARKET_ADDRESS=
NEXT_PUBLIC_DEPLOY_BLOCK=

# ---- Cash Out -------------------------------------------------------------
# Deployed addresses come from config/<network>.json; these override them.
NEXT_PUBLIC_CASHOUT_MODULE=
NEXT_PUBLIC_CASHOUT_DIRECT_ADAPTER=
NEXT_PUBLIC_CASHOUT_SWAP_ADAPTER=

# Server only (never NEXT_PUBLIC_). Signs Cash Out orders; its address must be
# CashOutModule's orderSigner. Keep it in your host's secret store.
ORDER_SIGNER_PRIVATE_KEY=
# Minutes a signed order stays valid, and Route B's swap slippage (basis points).
ORDER_TTL_MINUTES=10
ROUTE_B_SLIPPAGE_BPS=50

# MOCK payout partner (demo). A: receives MUSD on Mezo. B: swaps and bridges
# USDC to Ethereum (to the user's own address, so testnet funds come back).
MOCK_ROUTE=A
# Where the mock receives MUSD on Route A (defaults to the treasury, else the signer).
MOCK_MUSD_DEPOSIT_ADDRESS=
# Optional wallet holding testnet MUSD, to act as the on-ramp for Pay back.
MOCK_TREASURY_PRIVATE_KEY=
MOCK_PAYOUT_DELAY_SECONDS=20

# Testnet only: a wallet holding testnet BTC behind the "Get test Bitcoin"
# button, which tops a tester up to what a first cash-out needs.
DEMO_FAUCET_PRIVATE_KEY=

# Banxa (Route B). The adapter stays off until both are set; sandbox by default.
BANXA_API_KEY=
BANXA_PARTNER_REF=
BANXA_ENV=sandbox
