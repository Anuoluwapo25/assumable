# Which network the app talks to: mezo | mezoTestnet | local
NEXT_PUBLIC_CHAIN=mezo

# The deployed BackstopVault (bMUSD). Printed by script/Deploy.s.sol.
# Local demo: 0xDc64a140Aa3E981100a9becA4E685f962f0cF6C9 (first run on a fresh anvil)
NEXT_PUBLIC_VAULT_ADDRESS=

# Block the vault was deployed in. The ledger reads events from here; without
# it, only the most recent 50,000 blocks are scanned.
NEXT_PUBLIC_VAULT_DEPLOY_BLOCK=

# Optional: a private RPC. Falls back to the chain's public endpoint.
NEXT_PUBLIC_RPC_URL=

# Only for the testnet demo deployment (script/DeployTestnetDemo.s.sol), whose
# pool is the test mock. Shows controls to mint MUSD and trigger liquidations.
NEXT_PUBLIC_DEMO=false
